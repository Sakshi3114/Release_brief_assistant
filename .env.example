# Set one key to use a real model. With neither, the app runs in mock mode
# (keyword rules instead of a model). If both are set, Claude is used.

# Claude (paid): https://platform.claude.com
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Gemini (has a free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# Database. Leave empty to use a local SQLite file (data/app.db).
# Set both to use a hosted Turso database, which a deployed app needs.
TURSO_DATABASE_URL=libsql://release-brief-sakshi3114.aws-ap-south-1.turso.io
